#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
mkdir -p state

IN="state/ready_scored_tradable.jsonl"
MID="state/ready_enriched.jsonl"
OUT="state/ready_final.jsonl"

# produce IN
bash scripts/filter_tradable.sh

if [ ! -s "$IN" ]; then
  echo "[READY] ERROR: $IN missing or empty after filter_tradable.sh" >&2
  ls -la state | sed -n '1,200p' >&2
  exit 1
fi

: > "$MID"
while IFS= read -r line; do
  [ -z "$line" ] && continue
  echo "$line" | python scripts/enrich_stub.py >> "$MID"
done < "$IN"

cp -f "$MID" "$OUT"
echo "[READY] OK: $(wc -l < "$OUT") lines -> $OUT"
