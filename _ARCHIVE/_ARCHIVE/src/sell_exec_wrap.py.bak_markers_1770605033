#!/usr/bin/env python3
import os, sys, time, subprocess
from pathlib import Path

def _now(): return time.time()

def _swap_throttle():
    sec = float(os.getenv("SELL_SWAP_MIN_INTERVAL_SEC", "10"))
    if sec <= 0:
        return
    f = Path(os.getenv("SELL_SWAP_THROTTLE_FILE", "state/.jup_swap_last_ts.txt"))
    try:
        last = float(f.read_text().strip() or "0")
    except Exception:
        last = 0.0
    wait = (last + sec) - _now()
    if wait > 0:
        time.sleep(wait)
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(str(_now()))

def _is_429(blob: str) -> bool:
    b = (blob or "").lower()
    return ("too many requests" in b) or ("http 429" in b) or (" 429 " in b) or ("client error: too many requests" in b)

def _is_1788(blob: str) -> bool:
    b = (blob or "").lower()
    return ("0x1788" in b) or ("custom': 6024" in b) or ("custom\": 6024" in b) or ("custom program error: 0x1788" in b)

def main():
    max_429 = int(os.getenv("SELL_429_MAX_RETRY", "2"))
    backoff = int(os.getenv("SELL_429_BACKOFF_SEC", "20"))

    cmd = [sys.executable, "-u", "src/sell_exec.py"] + sys.argv[1:]
    last_out = ""
    for i in range(max_429 + 1):
        _swap_throttle()
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=os.environ.copy())
        out = p.stdout or ""
        last_out = out
        sys.stdout.write(out)
        sys.stdout.flush()

        if _is_1788(out):
            print("ROUTE_FAIL_0x1788", flush=True)
            raise SystemExit(42)

        if _is_429(out):
            if i < max_429:
                time.sleep(backoff * (i + 1))
                continue
            print("HTTP_429", flush=True)
            raise SystemExit(43)

        raise SystemExit(p.returncode)

    # safety
    print("HTTP_429", flush=True)
    raise SystemExit(43)

if __name__ == "__main__":
    main()
