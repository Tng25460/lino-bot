#!/usr/bin/env python3
"""
Stable wrapper around src/sell_exec.py

Maps common Jupiter / RPC failures to stable exit codes:

42 -> __ROUTE_FAIL__
43 -> __JUP_INSUFFICIENT_FUNDS__
44 -> __JUP_HTTP_429__
45 -> __TOKEN_NOT_TRADABLE__

Never exits 0 on failure.
"""

import subprocess
import sys
import re

RC_ROUTE_FAIL = 42
RC_INSUFF     = 43
RC_HTTP_429   = 44
RC_NOT_TRAD   = 45

def classify_output(text: str) -> int:
    low = text.lower()

    # 429
    if "429" in low:
        print("__JUP_HTTP_429__", flush=True)
        return RC_HTTP_429

    # route fail
    if "could not find any route" in low or "no route" in low or "0x1788" in low:
        print("__ROUTE_FAIL__", flush=True)
        return RC_ROUTE_FAIL

    # insufficient
    if "insufficient" in low or "not enough" in low:
        print("__JUP_INSUFFICIENT_FUNDS__", flush=True)
        return RC_INSUFF

    # generic 400
    if "400" in low:
        print("__TOKEN_NOT_TRADABLE__", flush=True)
        return RC_NOT_TRAD

    return 0

def main():
    cmd = [sys.executable, "-u", "src/sell_exec.py"] + sys.argv[1:]

    proc = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )

    output = proc.stdout or ""
    print(output, end="")

    # if child already failed, classify
    if proc.returncode != 0 or "FATAL:" in output:
        rc = classify_output(output)
        if rc != 0:
            sys.exit(rc)
        sys.exit(1)

    # success path
    sys.exit(0)

if __name__ == "__main__":
    main()
