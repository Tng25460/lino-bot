#!/usr/bin/env python3
import os, sys, inspect, traceback, sqlite3, json
from typing import Any, Dict

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(REPO)
sys.path.insert(0, REPO)

DB_PATH = os.getenv("TRADES_DB", "state/trades.sqlite")
KEYPAIR_PATH = os.getenv("KEYPAIR_PATH", "keypair.json")
RPCW = (os.getenv("RPC_HTTP_WRITE") or os.getenv("RPC_HTTP") or "https://api.mainnet-beta.solana.com").split(",")[0].strip()

def _count_open() -> int:
    con = sqlite3.connect(DB_PATH); cur = con.cursor()
    n = cur.execute("SELECT COUNT(*) FROM positions WHERE close_ts IS NULL").fetchone()[0]
    con.close()
    return int(n)

def _load_wallet_any():
    # solders Keypair
    try:
        from solders.keypair import Keypair
        p = KEYPAIR_PATH
        if not os.path.isabs(p):
            p = os.path.join(REPO, p)
        b = json.loads(open(p, "r", encoding="utf-8").read())
        return Keypair.from_bytes(bytes(b))
    except Exception:
        return None

def _mk_db_adapter_any():
    # Prefer PositionsDBAdapter if available
    try:
        from core.positions_db_adapter import PositionsDBAdapter
        return PositionsDBAdapter(DB_PATH)
    except Exception:
        return None

def _mk_engine():
    from core.sell_engine import SellEngine

    sig = inspect.signature(SellEngine.__init__)
    params = list(sig.parameters.values())[1:]  # drop self
    required = [p for p in params if p.default is inspect._empty and p.kind in (p.POSITIONAL_OR_KEYWORD, p.KEYWORD_ONLY)]
    names = [p.name for p in params]

    print("[SellEngine.__init__]", str(sig), flush=True)
    if required:
        print("[required]", [p.name for p in required], flush=True)
    else:
        print("[required] none", flush=True)

    wallet = _load_wallet_any()
    db_adapter = _mk_db_adapter_any()

    # Build kwargs heuristically
    kw: Dict[str, Any] = {}
    for n in names:
        ln = n.lower()
        if ln in ("db_path","trades_db","sqlite_path","dbfile","db_file","positions_db_path"):
            kw[n] = DB_PATH
        elif ln in ("db","positions_db","adapter","positions_adapter","db_adapter"):
            if db_adapter is not None:
                kw[n] = db_adapter
        elif ln in ("wallet","keypair","kp","signer"):
            if wallet is not None:
                kw[n] = wallet
        elif ln in ("rpc","rpc_url","rpc_http","rpc_http_write","rpcw","rpc_endpoint"):
            kw[n] = RPCW

    # First try kwargs only
    try:
        return SellEngine(**kw)
    except Exception as e1:
        print("[WARN] ctor kwargs failed:", repr(e1), flush=True)

    # Then try positional with the required params order, using our best mapping
    args = []
    for p in required:
        ln = p.name.lower()
        if ln in ("db_path","trades_db","sqlite_path","dbfile","db_file","positions_db_path"):
            args.append(DB_PATH)
        elif ln in ("db","positions_db","adapter","positions_adapter","db_adapter"):
            if db_adapter is None:
                raise RuntimeError("Need PositionsDBAdapter but cannot import/create it")
            args.append(db_adapter)
        elif ln in ("wallet","keypair","kp","signer"):
            if wallet is None:
                raise RuntimeError("Need wallet/keypair but cannot load keypair.json")
            args.append(wallet)
        elif ln in ("rpc","rpc_url","rpc_http","rpc_http_write","rpcw","rpc_endpoint"):
            args.append(RPCW)
        else:
            raise RuntimeError(f"Do not know how to satisfy required param: {p.name}")

    return SellEngine(*args)

def main():
    print("----- SELL_ENGINE_ONCE -----", flush=True)
    print("[cwd]", os.getcwd(), flush=True)
    print("[db ]", DB_PATH, flush=True)
    print("[rpc]", RPCW, flush=True)
    print("[env] SELL_WRAP_SIMULATE_MAP=", (os.getenv("SELL_WRAP_SIMULATE_MAP") or "")[:500], flush=True)

    eng = _mk_engine()
    before = _count_open()
    print("[db] open_before=", before, flush=True)

    out = eng.run_once()
    if inspect.iscoroutine(out):
        import asyncio
        asyncio.run(out)

    after = _count_open()
    print("[db] open_after =", after, flush=True)
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as e:
        print("[FATAL]", e, flush=True)
        traceback.print_exc()
        raise SystemExit(1)
