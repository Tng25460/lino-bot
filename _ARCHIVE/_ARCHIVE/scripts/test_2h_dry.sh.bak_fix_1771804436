#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="${REPO_ROOT:-/home/tng25/lino_FINAL_20260203_182626}"
cd "$REPO_ROOT" || exit 1
source .venv/bin/activate || true

# stop all
touch state/STOP 2>/dev/null || true
bash scripts/stop_all.sh 2>/dev/null || true
sleep 2
rm -f state/STOP 2>/dev/null || true
rm -f state/h24_watchdog.lock 2>/dev/null || true

# reset runtime
: > state/skip_mints_trader.txt
rm -f state/rl_skip_mints.json 2>/dev/null || true

# restore lastgood tradable if present
if [ -s state/ready_scored_tradable.lastgood.jsonl ]; then
  cp -a state/ready_scored_tradable.lastgood.jsonl state/ready_scored_tradable.jsonl
fi

# safe env (DRY)
export WALLET_PUBKEY="9U69xxU9eWRebdQ99FSo2FBwfafQZYjL4DT6ZFLqwmga"
export TRADER_USER_PUBLIC_KEY="$WALLET_PUBKEY"
export KEYPAIR_PATH="$REPO_ROOT/keypair.json"
export TRADER_DRY_RUN=1
export READY_FILE="state/ready_scored_tradable.jsonl"
export BUY_AMOUNT_SOL=0.003
export MIN_SOL_BUFFER_SOL=0.12
export SLIPPAGE_BPS=300
export MAX_PRICE_IMPACT_PCT=4.0
export STRICT_ONLY=1
export ROUTE_GATE_MODE=any
export NO_BUY_BACKOFF_SEC=60
export MIN_TRADABLE_LINES=20
export DISABLE_HIST_BAD=1

: > state/watchdog.out
nohup bash scripts/h24_watchdog.sh > state/watchdog.out 2>&1 &
echo "WATCHDOG PID=$!"

# run 2h
sleep $((2*60*60))

# stop clean
touch state/STOP 2>/dev/null || true
bash scripts/stop_all.sh 2>/dev/null || true
sleep 2
rm -f state/STOP 2>/dev/null || true
rm -f state/h24_watchdog.lock 2>/dev/null || true

echo "DONE: 2h dry test"
LOG="$(ls -1t state/h24_*.log 2>/dev/null | head -n 1 || true)"
echo "LAST_LOG=$LOG"
[ -n "${LOG}" ] && tail -n 200 "$LOG" | grep -aE "ready_count=|pick=|NO_BUY|built tx|sent txsig=|recorded BUY|429|RL_SKIP|Traceback|FATAL" | tail -n 120 || true
