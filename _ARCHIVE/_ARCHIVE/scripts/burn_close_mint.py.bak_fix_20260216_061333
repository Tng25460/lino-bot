#!/usr/bin/env python3
import argparse
import base64
import json
import os
import subprocess
import sys
import time
from typing import Any, Dict, Optional

import requests

# ---- JSON-RPC helpers ----

def rpc_call(rpc: str, method: str, params: list, timeout_s: int = 25) -> Any:
    payload = {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
    r = requests.post(rpc, json=payload, timeout=timeout_s)
    r.raise_for_status()
    j = r.json()
    if "error" in j and j["error"]:
        raise RuntimeError(j["error"])
    return j.get("result")

def wait_sig(rpc: str, sig: str, timeout_s: int = 60, poll_s: float = 1.0) -> Dict[str, Any]:
    """
    Confirm via getSignatureStatuses (widely supported).
    Returns the status dict (may include err).
    """
    t0 = time.time()
    last = None
    while True:
        res = rpc_call(rpc, "getSignatureStatuses", [[sig], {"searchTransactionHistory": True}], timeout_s=25)
        v = (res or {}).get("value") or [None]
        st = v[0]
        if st:
            last = st
            cs = st.get("confirmationStatus")
            err = st.get("err")
            # confirmationStatus can be "processed"/"confirmed"/"finalized"
            if cs:
                print("[confirm]", cs, "err=", err, flush=True)
            if cs in ("confirmed", "finalized"):
                return st
        if time.time() - t0 > timeout_s:
            raise TimeoutError({"sig": sig, "last": last})
        time.sleep(poll_s)

# ---- SPL Token / Close ATA logic ----
# This script assumes your existing tx builder inside this repo.
# It relies on solders/solana libs already in your env, as your previous script did.
# We keep it simple: reuse existing logic by importing the old builder if present,
# else fall back to running solana-cli commands is NOT supported for burn+close in one tx.

def solana_address(keypair_path: str) -> str:
    return subprocess.check_output(["solana", "address", "-k", keypair_path], text=True).strip()

def get_token_account_for_mint(rpc: str, owner: str, mint: str) -> Optional[Dict[str, Any]]:
    # Tokenkeg program id
    TOKEN_PROGRAM = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
    res = rpc_call(
        rpc,
        "getTokenAccountsByOwner",
        [owner, {"programId": TOKEN_PROGRAM}, {"encoding": "jsonParsed"}],
        timeout_s=25,
    )
    vals = (res or {}).get("value") or []
    for it in vals:
        info = it["account"]["data"]["parsed"]["info"]
        if info.get("mint") == mint:
            return it
    return None

def main() -> int:
    ap = argparse.ArgumentParser(description="Burn remaining token amount and close ATA for a mint.")
    ap.add_argument("--rpc", required=True, help="RPC HTTP endpoint (write-enabled)")
    ap.add_argument("--mint", required=True, help="Token mint to burn+close")
    ap.add_argument("--keypair", default="keypair.json", help="Signer keypair path (default: keypair.json)")
    ap.add_argument("--commitment", default="confirmed", choices=["processed", "confirmed", "finalized"])
    ap.add_argument("--sig-timeout", type=int, default=int(os.getenv("BURN_CLOSE_SIG_TIMEOUT_S", "75")))
    args = ap.parse_args()

    rpc = args.rpc
    mint = args.mint
    keypair = args.keypair
    owner = solana_address(keypair)

    acct = get_token_account_for_mint(rpc, owner, mint)
    if not acct:
        print("[skip] no token account found for mint (already closed?)", mint, flush=True)
        return 0

    pubkey = acct["pubkey"]
    info = acct["account"]["data"]["parsed"]["info"]
    tok = info["tokenAmount"]
    ui = float(tok.get("uiAmount") or 0.0)
    dec = int(tok.get("decimals") or 0)
    amount = int(tok.get("amount") or "0")

    print("[acct]", pubkey, flush=True)
    print("[mint]", mint, flush=True)
    print("[ui]  ", ui, " [amount]", amount, " [dec]", dec, flush=True)

    if amount <= 0:
        print("[skip] amount=0 -> try close only via your existing builder", flush=True)

    # Import your existing builder from the repo if it exists.
    # Your previous script clearly had tx build+send working; keep same approach:
    try:
        # If your repo has a module function already, adjust here if needed.
        # We try a few common patterns to be robust.
        from scripts._burn_close_impl import build_burn_close_tx  # type: ignore
    except Exception:
        build_burn_close_tx = None

    if build_burn_close_tx is None:
        # fallback: use the script-local implementation if it exists in this file (older versions)
        # If not present, we cannot reliably build SPL instructions without pulling libs.
        # So we fail with a clear message.
        raise SystemExit(
            "[ERR] Missing build_burn_close_tx().\n"
            "This repo previously had burn+close tx builder logic in scripts/burn_close_mint.py.\n"
            "Your file got mangled by patch attempts.\n"
            "Fix: restore a known-good backup or provide the old builder code.\n"
            "Tip: list backups: ls -1t scripts/burn_close_mint.py.bak_* | head"
        )

    # Build tx (expects to return raw tx bytes base64 or a ready tx object; we normalize)
    tx = build_burn_close_tx(mint=mint, owner_keypair_path=keypair, rpc=rpc)

    # Send
    # If builder returned raw bytes:
    if isinstance(tx, (bytes, bytearray)):
        tx_b64 = base64.b64encode(bytes(tx)).decode("ascii")
        sig = rpc_call(rpc, "sendTransaction", [tx_b64, {"encoding": "base64", "skipPreflight": False}])
    else:
        # If builder returned a dict with 'tx_b64'
        if isinstance(tx, dict) and "tx_b64" in tx:
            sig = rpc_call(rpc, "sendTransaction", [tx["tx_b64"], {"encoding": "base64", "skipPreflight": False}])
        else:
            # last resort: if builder returned already-sent signature
            if isinstance(tx, str) and len(tx) > 20:
                sig = tx
            else:
                raise SystemExit("[ERR] Unsupported tx builder return type: " + str(type(tx)))

    print("[send] sig=", sig, flush=True)

    st = wait_sig(rpc, sig, timeout_s=args.sig_timeout, poll_s=1.0)
    if st.get("err"):
        raise SystemExit({"sig": sig, "err": st.get("err")})

    print("[OK] burn+close finalized/confirmed", flush=True)
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\n[INT] ctrl-c", flush=True)
        raise
