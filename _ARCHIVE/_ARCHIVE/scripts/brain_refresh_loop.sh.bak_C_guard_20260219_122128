#!/usr/bin/env bash
set -euo pipefail

cd /home/tng25/lino_FINAL_20260203_182626
source .venv/bin/activate

SLEEP_SEC="${SLEEP_SEC:-120}"

export BRAIN_SCORE_MIN="${BRAIN_SCORE_MIN:-0.03}"
export BRAIN_TOPN="${BRAIN_TOPN:-40}"
export FILTER_TRADABLE_MIN_INTERVAL_SEC="${FILTER_TRADABLE_MIN_INTERVAL_SEC:-0.6}"
export FILTER_TRADABLE_RETRIES="${FILTER_TRADABLE_RETRIES:-4}"
export FILTER_TRADABLE_ON429_KEEP="${FILTER_TRADABLE_ON429_KEEP:-1}"
export FILTER_TRADABLE_AMOUNT="${FILTER_TRADABLE_AMOUNT:-10000000}"
export FILTER_TRADABLE_SLIP_BPS="${FILTER_TRADABLE_SLIP_BPS:-120}"

mkdir -p state

while true; do
  echo "[brain_refresh] cycle start $(date -Is)"

  # 1) Brain scoring -> state/ready_scored.jsonl
  python -u src/brain/brain_loop.py >> state/brain_loop.log 2>&1 || true

  # 2) Tradable filter -> state/ready_scored_tradable.jsonl
  python -u scripts/filter_ready_tradable.py \
    --in  state/ready_scored.jsonl \
    --out state/ready_scored_tradable.jsonl \
    --top-n "$BRAIN_TOPN" \
    --min-score "$BRAIN_SCORE_MIN" \
    --retries "$FILTER_TRADABLE_RETRIES" \
    --min-interval-sec "$FILTER_TRADABLE_MIN_INTERVAL_SEC" \
    --timeout 8 \
    >> state/brain_refresh_loop.log 2>&1 || true

  echo "[brain_refresh] cycle end $(date -Is)"
  sleep "$SLEEP_SEC"
done
