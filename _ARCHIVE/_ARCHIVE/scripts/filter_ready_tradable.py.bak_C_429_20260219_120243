#!/usr/bin/env python3
import argparse, json, os, sys, time
import urllib.request, urllib.error

SOL = "So11111111111111111111111111111111111111112"

def _read_jsonl(path: str):
    rows = []
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for ln in f:
            ln = ln.strip()
            if not ln:
                continue
            try:
                rows.append(json.loads(ln))
            except Exception:
                pass
    return rows

def _write_jsonl(path: str, rows):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")

def _get_mint(row):
    for k in ("mint","output_mint","out_mint","token","address"):
        v = row.get(k)
        if isinstance(v, str) and v.strip():
            return v.strip()
    return None

def _to_float(x, default=0.0):
    try:
        return float(x)
    except Exception:
        return float(default)

def _quote_ok(jup_base: str, mint: str, amount: int, slip_bps: int, timeout: int, retries: int, on429_keep: bool, min_interval_s: float):
    url = f"{jup_base.rstrip('/')}/swap/v1/quote?inputMint={SOL}&outputMint={mint}&amount={amount}&slippageBps={slip_bps}"
    last429 = False
    for attempt in range(max(1, int(retries))):
        if min_interval_s > 0:
            time.sleep(float(min_interval_s))
        try:
            with urllib.request.urlopen(url, timeout=timeout) as r:
                body = r.read()
            _ = json.loads(body.decode("utf-8", errors="replace"))
            return True
        except urllib.error.HTTPError as e:
            if int(getattr(e, "code", 0)) == 429:
                last429 = True
                time.sleep(0.35 + 0.25 * attempt)
                continue
            return False
        except Exception:
            return False
    if last429 and on429_keep:
        return True
    return False

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--in", dest="inp", required=True)
    ap.add_argument("--out", dest="out", required=True)
    ap.add_argument("--jup", dest="jup", default=os.getenv("JUP_BASE_URL","https://lite-api.jup.ag"))
    ap.add_argument("--amount", dest="amount", type=int, default=int(os.getenv("FILTER_TRADABLE_AMOUNT","10000000")))
    ap.add_argument("--slip-bps", dest="slip_bps", type=int, default=int(os.getenv("FILTER_TRADABLE_SLIP_BPS","120")))
    ap.add_argument("--timeout", dest="timeout", type=int, default=20)
    ap.add_argument("--retries", dest="retries", type=int, default=int(os.getenv("FILTER_TRADABLE_RETRIES","6")))
    ap.add_argument("--on429-keep", dest="on429_keep", type=int, default=int(os.getenv("FILTER_TRADABLE_ON429_KEEP","1")))
    ap.add_argument("--min-interval-sec", dest="min_interval_sec", type=float, default=float(os.getenv("FILTER_TRADABLE_MIN_INTERVAL_SEC","0.25")))
    ap.add_argument("--min-score", dest="min_score", type=float, default=float(os.getenv("BRAIN_SCORE_MIN","0.12")))
    ap.add_argument("--top-n", dest="top_n", type=int, default=int(os.getenv("BRAIN_TOPN","60")))
    args = ap.parse_args()

    rows = _read_jsonl(args.inp)
    print(f"[filter_ready_tradable] rows_in={len(rows)} file={args.inp}", flush=True)

    # normalize + score filter + topN
    rr = []
    for r in rows:
        m = _get_mint(r)
        if not m:
            continue
        r["_mint"] = m
        s = _to_float(r.get("score", r.get("brain_score", r.get("score_v4", 0.0))), 0.0)
        r["_score"] = s
        rr.append(r)
    print(f"[filter_ready_tradable] rows_with_mint={len(rr)}", flush=True)

    rr.sort(key=lambda x: x.get("_score", 0.0), reverse=True)
    rr = rr[:max(1, int(args.top_n))]
    rr = [r for r in rr if float(r.get("_score",0.0)) >= float(args.min_score)]

    kept = []
    bad = 0
    soft429 = 0
    for r in rr:
        m = r["_mint"]
        ok = _quote_ok(args.jup, m, args.amount, args.slip_bps, args.timeout, args.retries, bool(args.on429_keep), args.min_interval_sec)
        if ok:
            # remove internal keys
            r.pop("_mint", None); r.pop("_score", None)
            kept.append(r)
        else:
            bad += 1

    _write_jsonl(args.out, kept)
    print(f"DONE kept={len(kept)} bad={bad} soft429={soft429} OUT={args.out}", flush=True)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
