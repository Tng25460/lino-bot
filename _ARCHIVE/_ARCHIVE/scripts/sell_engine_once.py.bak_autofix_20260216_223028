#!/usr/bin/env python3
import os, sys, inspect, traceback, sqlite3

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(REPO)
sys.path.insert(0, REPO)

DB_PATH = os.getenv("TRADES_DB", "state/trades.sqlite")

def _count_open():
    con = sqlite3.connect(DB_PATH); cur = con.cursor()
    n = cur.execute("SELECT COUNT(*) FROM positions WHERE close_ts IS NULL").fetchone()[0]
    con.close()
    return n

def _mk_engine():
    from core.sell_engine import SellEngine
    # try common constructor variants safely
    try:
        return SellEngine(db_path=DB_PATH)
    except Exception:
        pass
    try:
        return SellEngine(DB_PATH)
    except Exception:
        pass
    try:
        return SellEngine()
    except Exception:
        pass
    try:
        from core.positions_db_adapter import PositionsDBAdapter
        db = PositionsDBAdapter(DB_PATH)
        return SellEngine(db=db)
    except Exception:
        pass
    raise RuntimeError("Cannot construct SellEngine (check core/sell_engine.py __init__)")

def main():
    print("----- SELL_ENGINE_ONCE -----", flush=True)
    print("[cwd]", os.getcwd(), flush=True)
    print("[db ]", DB_PATH, flush=True)
    print("[env] SELL_WRAP_SIMULATE_MAP=", (os.getenv("SELL_WRAP_SIMULATE_MAP") or "")[:500], flush=True)

    eng = _mk_engine()
    before = _count_open()
    print("[db] open_before=", before, flush=True)

    out = eng.run_once()
    if inspect.iscoroutine(out):
        import asyncio
        asyncio.run(out)

    after = _count_open()
    print("[db] open_after =", after, flush=True)
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as e:
        print("[FATAL]", e, flush=True)
        traceback.print_exc()
        raise SystemExit(1)
