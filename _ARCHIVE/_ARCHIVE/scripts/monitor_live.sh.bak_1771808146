#!/usr/bin/env bash
set -euo pipefail
cd "${REPO_ROOT:-/home/tng25/lino_FINAL_20260203_182626}" || exit 1

LOG="${LOG:-$(ls -1t state/h24_*.log 2>/dev/null | head -n 1 || true)}"
if [ -z "${LOG}" ] || [ ! -f "${LOG}" ]; then
  echo "NO h24 log found in state/ (expected state/h24_*.log)"
  ls -1t state/*.log 2>/dev/null | head -n 20 || true
  exit 1
fi

echo "LOG=${LOG}"
tail -n 3 "${LOG}" | sed 's/^/TAIL3: /' || true
echo
echo "---- follow (Ctrl+C to stop) ----"
tail -f "${LOG}" | grep -aE \
"ready_count=|pick=|NO_BUY|built tx|sent txsig=|recorded BUY|quote failed http= *429|RL_SKIP add|🧊 RL_SKIP|already holding|autoskip|SELL_TICK|\[SELL\]|TP1|TP2|route_fail|INSUFFICIENT|Traceback|FATAL"
