import os, sys, base64, json, struct, argparse, subprocess, requests
from solders.keypair import Keypair
from solders.pubkey import Pubkey
from solders.instruction import Instruction, AccountMeta
from solders.transaction import Transaction
from solders.hash import Hash
import time


TOKEN_PROGRAM_ID = Pubkey.from_string("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA")

def rpc_call(rpc: str, method: str, params):
    r = requests.post(rpc, json={"jsonrpc":"2.0","id":1,"method":method,"params":params}, timeout=25)
    r.raise_for_status()
    j = r.json()
    if "error" in j:
        raise RuntimeError(j["error"])
    return j["result"]

def get_owner_pubkey():
    return subprocess.check_output(["solana","address","-k","keypair.json"], text=True).strip()

def load_keypair(path="keypair.json"):
    raw = json.loads(open(path,"r",encoding="utf-8").read())
    return Keypair.from_bytes(bytes(raw))

def ix_burn(token_account: Pubkey, mint: Pubkey, owner: Pubkey, amount: int) -> Instruction:
    # SPL Token Burn = 8, data = u8(8) + u64(amount LE)
    data = bytes([8]) + struct.pack("<Q", amount)
    keys = [
        AccountMeta(pubkey=token_account, is_signer=False, is_writable=True),
        AccountMeta(pubkey=mint,         is_signer=False, is_writable=True),
        AccountMeta(pubkey=owner,        is_signer=True,  is_writable=False),
    ]
    return Instruction(program_id=TOKEN_PROGRAM_ID, data=data, accounts=keys)

def ix_close(token_account: Pubkey, dest: Pubkey, owner: Pubkey) -> Instruction:
    # SPL Token CloseAccount = 9, data = u8(9)
    data = bytes([9])
    keys = [
        AccountMeta(pubkey=token_account, is_signer=False, is_writable=True),
        AccountMeta(pubkey=dest,          is_signer=False, is_writable=True),
        AccountMeta(pubkey=owner,         is_signer=True,  is_writable=False),
    ]
    return Instruction(program_id=TOKEN_PROGRAM_ID, data=data, accounts=keys)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mint", required=True)
    ap.add_argument("--rpc", default=os.getenv("RPC_HTTP_WRITE") or os.getenv("RPC_HTTP_READ") or "https://api.mainnet-beta.solana.com")
    ap.add_argument("--dry", action="store_true")
    args = ap.parse_args()

    rpc = args.rpc.split(",")[0].strip()
    owner_str = get_owner_pubkey()
    owner = Pubkey.from_string(owner_str)
    mint = Pubkey.from_string(args.mint)
    kp = load_keypair("keypair.json")

    # Fetch token accounts for this mint
    res = rpc_call(rpc, "getTokenAccountsByOwner", [
        owner_str,
        {"mint": args.mint},
        {"encoding":"jsonParsed"}
    ])
    accts = res.get("value", [])
    if not accts:
        print("no token accounts for mint", args.mint)
        return 0

    # Latest blockhash
    bh = rpc_call(rpc, "getLatestBlockhash", [{"commitment":"confirmed"}])["value"]["blockhash"]
    blockhash = Hash.from_string(bh)

    any_sent = False
    for it in accts:
        pub = it["pubkey"]
        info = it["account"]["data"]["parsed"]["info"]
        tok = info["tokenAmount"]
        amount_str = tok.get("amount") or "0"   # base units string
        amount = int(amount_str)
        ui = float(tok.get("uiAmount") or 0.0)

        print(f"\n[acct] {pub}")
        print(f"[mint] {args.mint}")
        print(f"[ui]   {ui}  [amount] {amount}")

        if amount <= 0:
            print(" -> amount=0 (skip burn), will try close")
            ixs = [ix_close(Pubkey.from_string(pub), owner, owner)]
        else:
            ixs = [
                ix_burn(Pubkey.from_string(pub), mint, owner, amount),
                ix_close(Pubkey.from_string(pub), owner, owner),
            ]

        tx = Transaction.new_signed_with_payer(
            ixs,
            owner,
            [kp],
            blockhash,
        )

        b64 = base64.b64encode(bytes(tx)).decode("ascii")
        print("[tx] built burn+close")
        if args.dry:
            print("[DRY] skip send")
            continue

        sig = rpc_call(rpc, "sendTransaction", [b64, {"encoding":"base64","skipPreflight":False,"preflightCommitment":"confirmed"}])
        any_sent = True
        print("[send] sig=", sig)
        # confirm via getSignatureStatuses (more widely supported)
        conf = None
        for _ in range(60):
            st = rpc_call(rpc, "getSignatureStatuses", [[sig], {"searchTransactionHistory": True}])
            v = (st.get("value") or [None])[0]
            if v and v.get("confirmationStatus"):
                print("[confirm]", v.get("confirmationStatus"), "err=", v.get("err"))
                conf = v
                break
            time.sleep(1.0)

        print("[confirm]", conf)

    if any_sent:
        print("\n[OK] done")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
