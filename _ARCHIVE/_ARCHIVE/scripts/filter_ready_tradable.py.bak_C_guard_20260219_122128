#!/usr/bin/env python3
import argparse, json, os, time, random
import urllib.request, urllib.error

SOL = "So11111111111111111111111111111111111111112"
MINT_KEYS  = ("mint","output_mint","outputMint","token","address")
SCORE_KEYS = ("score","brain_score","final_score","score_v4","scoreV4","score_total")

def _read_jsonl(path: str):
    out=[]
    with open(path,"r",encoding="utf-8",errors="replace") as f:
        for ln in f:
            ln=ln.strip()
            if not ln: continue
            try: out.append(json.loads(ln))
            except Exception: pass
    return out

def _write_jsonl_atomic(path: str, rows):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    os.replace(tmp, path)

def _get_first(d: dict, keys):
    for k in keys:
        v = d.get(k)
        if isinstance(v,str) and v.strip():
            return v.strip()
    return ""

def _score_of(d: dict) -> float:
    for k in SCORE_KEYS:
        v = d.get(k)
        if isinstance(v,(int,float)):
            return float(v)
        if isinstance(v,str):
            try: return float(v)
            except Exception: pass
    return 0.0

def _quote(jup_base: str, out_mint: str, amount: int, slip_bps: int, timeout: float):
    url = f"{jup_base.rstrip('/')}/swap/v1/quote?inputMint={SOL}&outputMint={out_mint}&amount={amount}&slippageBps={slip_bps}"
    req = urllib.request.Request(url, headers={"accept":"application/json"})
    raw = urllib.request.urlopen(req, timeout=timeout).read()
    return json.loads(raw.decode("utf-8","replace"))

def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--in", dest="inp", required=True)
    ap.add_argument("--out", dest="out", required=True)
    ap.add_argument("--jup-base", default=os.getenv("JUP_BASE_URL","https://lite-api.jup.ag"))
    ap.add_argument("--min-score", type=float, default=float(os.getenv("BRAIN_SCORE_MIN","0.12")))
    ap.add_argument("--top-n", type=int, default=int(os.getenv("BRAIN_TOPN","60")))
    ap.add_argument("--min-interval-sec", type=float, default=float(os.getenv("FILTER_TRADABLE_MIN_INTERVAL_SEC","0.45")))
    ap.add_argument("--retries", type=int, default=int(os.getenv("FILTER_TRADABLE_RETRIES","10")))
    ap.add_argument("--on429-keep", type=int, default=int(os.getenv("FILTER_TRADABLE_ON429_KEEP","1")))
    ap.add_argument("--amount", type=int, default=int(os.getenv("FILTER_TRADABLE_AMOUNT","10000000")))
    ap.add_argument("--slip-bps", type=int, default=int(os.getenv("FILTER_TRADABLE_SLIP_BPS","120")))
    ap.add_argument("--timeout", type=float, default=float(os.getenv("FILTER_TRADABLE_TIMEOUT","8")))
    ap.add_argument("--debug", type=int, default=int(os.getenv("FILTER_TRADABLE_DEBUG","0")))
    args=ap.parse_args()

    rows=_read_jsonl(args.inp)
    print(f"[filter_ready_tradable] rows_in={len(rows)} file={args.inp}", flush=True)

    rows2=[]
    for r in rows:
        mint=_get_first(r, MINT_KEYS)
        if mint:
            rr=dict(r)
            rr["mint"]=mint
            rows2.append(rr)

    print(f"[filter_ready_tradable] rows_with_mint={len(rows2)}", flush=True)

    # score filter + topN
    rows2.sort(key=lambda d: _score_of(d), reverse=True)
    rows2=[r for r in rows2 if _score_of(r) >= float(args.min_score)]
    rows2=rows2[: max(0,int(args.top_n))]

    top1 = rows2[0]["mint"] if rows2 else "-"
    top1s= _score_of(rows2[0]) if rows2 else 0.0
    print(f"[filter_ready_tradable] after_score top={len(rows2)} top1_mint={top1} top1_score={top1s:.4f}", flush=True)
    print(f"[filter_ready_tradable] jup={args.jup_base} amount={args.amount} slip_bps={args.slip_bps} retries={args.retries} on429_keep={args.on429_keep} min_interval={args.min_interval_sec}", flush=True)

    kept=[]
    bad=0
    soft429=0
    unauth=0

    last_t=0.0
    for idx,r in enumerate(rows2,1):
        mint=r["mint"]

        # throttle
        now=time.time()
        dt=now-last_t
        if dt < args.min_interval_sec:
            time.sleep(args.min_interval_sec - dt)
        last_t=time.time()

        ok=False
        for k in range(args.retries):
            try:
                _ = _quote(args.jup_base, mint, int(args.amount), int(args.slip_bps), timeout=float(args.timeout))
                ok=True
                break
            except urllib.error.HTTPError as e:
                code=getattr(e,"code",None)
                if code == 429:
                    soft429 += 1
                    # backoff + jitter, et on réessaie
                    time.sleep(min(8.0, (0.4*(2**k)) + random.random()*0.25))
                    continue
                if code in (401,403):
                    unauth += 1
                    break
                # autres erreurs => stop retry pour ce mint
                break
            except Exception:
                # network/DNS/timeouts => petit backoff
                time.sleep(min(4.0, 0.25*(2**k)))
                continue

        if ok:
            kept.append(r)
        else:
            bad += 1
            # si 429 seulement (soft), on peut garder quand même
            if args.on429_keep:
                kept.append(r)
                if args.debug:
                    print(f"[soft_keep] mint={mint} (failed but on429_keep=1)", flush=True)

        if args.debug and (idx % 10 == 0):
            print(f"[dbg] progress {idx}/{len(rows2)} kept={len(kept)} bad={bad} soft429={soft429}", flush=True)

    _write_jsonl_atomic(args.out, kept)
    print(f"DONE kept={len(kept)} bad={bad} soft429={soft429} unauth={unauth} OUT={args.out}", flush=True)
    return 0

if __name__=="__main__":
    raise SystemExit(main())
