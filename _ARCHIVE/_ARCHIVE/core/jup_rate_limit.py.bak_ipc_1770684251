import time, threading

_LOCK = threading.Lock()
_LAST_TS = 0.0

# 1 quote toutes les 3.5s par défaut
MIN_INTERVAL = float(
    __import__("os").getenv("JUP_MIN_QUOTE_INTERVAL_S", "3.5")
)

def wait_for_slot():
    global _LAST_TS
    with _LOCK:
        now = time.time()
        wait = MIN_INTERVAL - (now - _LAST_TS)
        if wait > 0:
            time.sleep(wait)
        _LAST_TS = time.time()
