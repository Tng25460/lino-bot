import os, time
import fcntl

# 1 quote toutes les N secondes (global IPC)
MIN_INTERVAL = float(os.getenv("JUP_MIN_QUOTE_INTERVAL_S", "3.5"))

# lock+state file shared across processes
LOCK_PATH = os.getenv("JUP_RL_LOCK_PATH", "/tmp/lino_jup_rl.lock")

def _read_last_ts(fd) -> float:
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        data = os.read(fd, 64) or b""
        s = data.decode("utf-8", "ignore").strip()
        return float(s) if s else 0.0
    except Exception:
        return 0.0

def _write_last_ts(fd, ts: float) -> None:
    os.lseek(fd, 0, os.SEEK_SET)
    os.write(fd, (f"{ts:.6f}\n").encode("utf-8"))
    os.ftruncate(fd, os.lseek(fd, 0, os.SEEK_CUR))

def wait_for_slot() -> None:
    os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True) if "/" in LOCK_PATH else None
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        last = _read_last_ts(fd)
        now = time.time()
        wait = MIN_INTERVAL - (now - last)
        if wait > 0:
            time.sleep(wait)
        _write_last_ts(fd, time.time())
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except Exception:
            pass
        os.close(fd)
