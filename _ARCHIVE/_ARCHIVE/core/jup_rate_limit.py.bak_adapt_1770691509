import os, time
import fcntl

# base interval
BASE_INTERVAL = float(os.getenv("JUP_MIN_QUOTE_INTERVAL_S", "3.5"))

# adaptive mode
AUTO = int(os.getenv("JUP_RL_AUTO", "1"))
MIN_INTERVAL = float(os.getenv("JUP_RL_MIN_S", str(BASE_INTERVAL)))
MAX_INTERVAL = float(os.getenv("JUP_RL_MAX_S", "12.0"))

# shared lock/state file across processes
LOCK_PATH = os.getenv("JUP_RL_LOCK_PATH", "/tmp/lino_jup_rl.lock")

def _read_state(fd):
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        data = os.read(fd, 256) or b""
        s = data.decode("utf-8", "ignore").strip()
        if not s:
            return 0.0, BASE_INTERVAL
        parts = s.split()
        last_ts = float(parts[0])
        cur_int = float(parts[1]) if len(parts) > 1 else BASE_INTERVAL
        return last_ts, cur_int
    except Exception:
        return 0.0, BASE_INTERVAL

def _write_state(fd, last_ts: float, cur_int: float):
    os.lseek(fd, 0, os.SEEK_SET)
    os.write(fd, (f"{last_ts:.6f} {cur_int:.6f}\n").encode("utf-8"))
    os.ftruncate(fd, os.lseek(fd, 0, os.SEEK_CUR))

def wait_for_slot() -> None:
    os.makedirs(os.path.dirname(LOCK_PATH) or "/", exist_ok=True)
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        last_ts, cur_int = _read_state(fd)

        now = time.time()
        wait = cur_int - (now - last_ts)
        if wait > 0:
            time.sleep(wait)

        _write_state(fd, time.time(), cur_int)
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except Exception:
            pass
        os.close(fd)

def note_result(ok: bool, was_429: bool = False) -> None:
    if not AUTO:
        return
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o666)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        last_ts, cur_int = _read_state(fd)

        if was_429:
            cur_int = min(MAX_INTERVAL, max(cur_int, MIN_INTERVAL) * 1.35)
        elif ok:
            cur_int = max(MIN_INTERVAL, cur_int * 0.92)
        else:
            cur_int = min(MAX_INTERVAL, cur_int * 1.10)

        _write_state(fd, last_ts, cur_int)
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except Exception:
            pass
        os.close(fd)
